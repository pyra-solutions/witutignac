# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore i nie trafia do repozytorium.

# Dostawca LLM do oceny: Eden AI (Francja), otwarte modele z przetwarzaniem w UE.
EDEN_AI_API_KEY=

# Opcjonalnie: bezpośredni dostęp do OVHcloud AI Endpoints (profil default).
OVH_AI_ENDPOINTS_ACCESS_TOKEN=

# Opcjonalnie: nadpisanie profilu dowolnym serwerem zgodnym z API OpenAI.
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_MODEL=Qwen3.5-9B
# LLM_API_KEY=

# Opcjonalnie: katalog cache konwersji i odpowiedzi LLM (domyślnie .o2j-cache, 'none' wyłącza).
# O2J_CACHE_DIR=
