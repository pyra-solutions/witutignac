# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore i nie trafia do repozytorium.

# Docelowy dostawca LLM do oceny (otwarty model, serwery w UE): OVHcloud AI Endpoints.
OVH_AI_ENDPOINTS_ACCESS_TOKEN=

# Tylko do prac deweloperskich (profil gemini-dev, uruchamiany z --llm-profile gemini-dev).
GEMINI_API_KEY=

# Opcjonalnie: nadpisanie profilu dowolnym serwerem zgodnym z API OpenAI.
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_MODEL=Qwen3.5-9B
# LLM_API_KEY=

# Opcjonalnie: katalog cache konwersji i odpowiedzi LLM (domyślnie .o2j-cache, 'none' wyłącza).
# O2J_CACHE_DIR=

# Baza backendu: PostgreSQL z docker-compose.yml. Bez DATABASE_URL backend łączy się
# z postgresql://o2j:o2j@localhost:5432/odwolania2json. Zmiana POSTGRES_* działa tylko przy
# tworzeniu wolumenu pgdata i wymaga tej samej zmiany w DATABASE_URL.
# DATABASE_URL=postgresql://o2j:o2j@localhost:5432/odwolania2json
# POSTGRES_USER=o2j
# POSTGRES_PASSWORD=o2j
# POSTGRES_DB=odwolania2json
# POSTGRES_PORT=5432
